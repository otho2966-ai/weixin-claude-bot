# ── Required: API for Claude Code ────────────────────────────
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=sk-your-key-here

# ── Optional: Claude Code CLI path (if not in config.json) ──
# CLAUDE_CODE_CLI=D:\path\to\claude-code\cli.js

# ── Optional: Claude Code working directory (if not in config.json) ──
# CLAUDE_CODE_CWD=D:\path\to\claude-code

# ── Optional: Tesseract OCR executable path ─────────────────
# Defaults to C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_PATH=D:\tools\Tesseract-OCR\tesseract.exe

# ── Optional: Tesseract data directory ──────────────────────
# Defaults to <bot-dir>/tessdata
# TESSDATA_PREFIX=D:\path\to\tessdata

# ── Optional: Git Bash path for Claude Code ─────────────────
# CLAUDE_CODE_GIT_BASH_PATH=D:\Program Files\Git\bin\bash.exe
